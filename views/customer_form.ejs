<%- include('partials/head') %>
<%- include('partials/nav') %>

<div class="page-head">
  <h1><%= customer.id ? 'Edit customer' : 'New customer' %></h1>
  <div class="page-actions"><a class="btn btn-ghost" href="/customers">← Back to customers</a></div>
</div>

<div class="card form-card">
  <form method="post"
        action="<%= customer.id ? '/customers/' + customer.id + '/edit' : '/customers/new' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? next : '' %>">

    <div class="grid-2">
      <div class="field">
        <label for="name">Name *</label>
        <input id="name" name="name" type="text" required maxlength="120" value="<%= customer.name || '' %>">
        <% if (errors.name) { %><p class="field-error"><%= errors.name %></p><% } %>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" maxlength="200" value="<%= customer.email || '' %>">
        <% if (errors.email) { %><p class="field-error"><%= errors.email %></p><% } %>
      </div>
      <div class="field">
        <label for="phone">Phone</label>
        <input id="phone" name="phone" type="text" maxlength="40" value="<%= customer.phone || '' %>">
      </div>
      <div class="field field-full">
        <label for="address">Address</label>
        <textarea id="address" name="address" rows="2" maxlength="400"><%= customer.address || '' %></textarea>
      </div>
      <div class="field field-full">
        <label for="notes">Notes (internal, not shown on invoices)</label>
        <textarea id="notes" name="notes" rows="2" maxlength="500"><%= customer.notes || '' %></textarea>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save customer</button>
      <a class="btn btn-ghost" href="<%= customer.id ? '/customers/' + customer.id + '/edit' : '/customers' %>">Cancel</a>
    </div>
  </form>
</div>
<%- include('partials/foot') %>
