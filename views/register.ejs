<%- include('partials/head') %>
<div class="auth-wrap">
  <div class="card auth-card">
    <div class="auth-logo">invoic<b>lite</b></div>
    <h1>Create your account</h1>
    <p class="muted">Invoicing and receipts for freelancers and small businesses.</p>
    <% if (errors.form) { %><div class="flash flash-error"><%= errors.form %></div><% } %>
    <form method="post" action="/register">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="name">Your name</label>
        <input id="name" name="name" type="text" value="<%= values.name || '' %>" required maxlength="80" autofocus>
        <% if (errors.name) { %><p class="field-error"><%= errors.name %></p><% } %>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" value="<%= values.email || '' %>" required maxlength="200">
        <% if (errors.email) { %><p class="field-error"><%= errors.email %></p><% } %>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" required minlength="8">
        <p class="hint">At least 8 characters.</p>
        <% if (errors.password) { %><p class="field-error"><%= errors.password %></p><% } %>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Create account</button>
    </form>
    <p class="auth-alt">Already have an account? <a href="/login">Log in</a></p>
  </div>
</div>
<%- include('partials/foot') %>
