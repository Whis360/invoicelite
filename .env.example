# InvoiceLite configuration — copy to .env and adjust.

# Public origin used to build shareable invoice links (no trailing slash).
# Set this to your real domain in production.
BASE_URL=http://localhost:3000

PORT=3000

# SQLite database file (created automatically).
DB_PATH=./data/invoicelite.db

# Where uploaded business logos are stored.
UPLOAD_DIR=./uploads

# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

NODE_ENV=development
